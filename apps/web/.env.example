# Postgres (local: createdb wildcat_clubs)
DATABASE_URL="postgresql://USER@localhost:5432/wildcat_clubs?schema=public"
# Public URL of this deployment (links in emails, QR codes)
APP_URL="http://localhost:3000"
# Sign-in: mock = test personas only · google = Google only · both = both (the default outside production).
# Test personas sign in with no password, so a production build is always Google-only
# unless ALLOW_TEST_SIGNIN="1" is also set — for a demo or user-testing server only, never real use.
# AUTH_MODE="both"
# ALLOW_TEST_SIGNIN=""
# Google sign-in (OAuth client for the Weber State Workspace)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""
# Workspace service account with domain-wide delegation (Calendar, Drive, Chat, Gmail) — one-line JSON
GOOGLE_SERVICE_ACCOUNT_JSON=""
PLATFORM_SENDER_EMAIL="clubs@weber.edu"
# Claude (assistant + grading assist). Also switch them on in System settings.
ANTHROPIC_API_KEY=""
# Protects /api/cron/tick (scheduled jobs)
CRON_SECRET="change-me"
